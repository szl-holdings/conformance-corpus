    {
      "id": "<failing-check-id>",
      "kind": "numeric_agreement",
      "version": "1",
      "required": true,
      "inputs": [
        "<input-id>"
      ],
      "params": {
        "column": "<column>",
        "expected": [
          {
            "key": "<row key>",
            "value": "<a value that disagrees with the stored one>"
          }
        ]
      }
    }
  ],
  "corpus": {
    "access_class": "SYNTHETIC",
    "permissions": {
      "evaluation_allowed": true,
      "training_allowed": false,
      "redistribution_allowed": false,
      "derivatives_allowed": false,
      "public_display_allowed": false,
      "commercial_use_allowed": false
    }
