{
  "schema": "science-gate-manifest/v1",
  "run_label": "corpus-<ENTRY_ID>",
  "inputs": [
    {
      "id": "<INPUT_ID>",
      "path": "fixtures/data/<FILE>.csv",
      "format": "csv",
      "required": true,
      "sha256": "<SHA256 OF THE FILE BYTES, 64 lowercase hex>",
      "row_key": [
        "<KEY_COLUMN>"
      ],
      "expected_rows": "<INTEGER: number of data records, declared independently>",
      "denominator_source": "INDEPENDENT"
    }
  ],
  "checks": [
    {
      "id": "rows",
      "kind": "row_count",
      "version": "1",
      "required": true,
      "inputs": [
        "<INPUT_ID>"
      ]
    },
    {
      "id": "citation-log",
      "kind": "verification_log",
      "version": "1",
      "required": true
    }
  ],
  "citations": {
    "entries": "fixtures/citations/entries.json",
    "log": "fixtures/citations/verification-log.json",
    "live": false
  },
  "corpus": {
    "access_class": "SYNTHETIC",
    "permissions": {
      "evaluation_allowed": true,
      "training_allowed": false,
      "redistribution_allowed": false,
      "derivatives_allowed": false,
      "public_display_allowed": false,
      "commercial_use_allowed": false
    }
  }
}
