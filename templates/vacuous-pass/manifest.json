{
  "schema": "science-gate-manifest/v1",
  "run_label": "corpus-<ENTRY_ID>",
  "inputs": [
    {
      "id": "<INPUT_ID>",
      "path": "fixtures/data/<EMPTY_FILE>.csv",
      "format": "csv",
      "required": true,
      "sha256": "<SHA256 OF THE FILE BYTES, 64 lowercase hex>",
      "row_key": [
        "<KEY_COLUMN>"
      ]
    }
  ],
  "checks": [
    {
      "id": "rows",
      "kind": "row_count",
      "version": "1",
      "required": true,
      "inputs": [
        "<INPUT_ID>"
      ]
    },
    {
      "id": "columns",
      "kind": "required_columns",
      "version": "1",
      "required": true,
      "inputs": [
        "<INPUT_ID>"
      ],
      "params": {
        "columns": [
          "<KEY_COLUMN>",
          "<OTHER_COLUMNS>"
        ]
      }
    },
    {
      "id": "duplicates",
      "kind": "duplicate_rows",
      "version": "1",
      "required": true,
      "inputs": [
        "<INPUT_ID>"
      ]
    },
    {
      "id": "stored-pass",
      "kind": "summary_consistency",
      "version": "1",
      "required": true
    }
  ],
  "summary_claim": "fixtures/summary/<STORED_SUMMARY>.json",
  "corpus": {
    "access_class": "SYNTHETIC",
    "permissions": {
      "evaluation_allowed": true,
      "training_allowed": false,
      "redistribution_allowed": false,
      "derivatives_allowed": false,
      "public_display_allowed": false,
      "commercial_use_allowed": false
    }
  }
}
