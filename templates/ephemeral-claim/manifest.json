{
  "schema": "science-gate-manifest/v1",
  "run_label": "corpus-ephemeral-claim-synthetic-NN",
  "inputs": [
    {
      "id": "<input-id>",
      "path": "fixtures/data/<input>.csv",
      "format": "csv",
      "required": true,
      "sha256": "<64 lowercase hex: SHA-256 of the exact bytes of the input file>",
      "row_key": [
        "<key column>"
      ],
      "expected_rows": "<row count known independently of the file; an integer>",
      "denominator_source": "INDEPENDENT"
    }
  ],
  "checks": [
    {
      "id": "rows",
      "kind": "row_count",
      "version": "1",
      "required": true,
      "inputs": [
        "<input-id>"
      ]
    },
    {
      "id": "claims",
      "kind": "claim_registry",
      "version": "1",
      "required": true
    }
  ],
  "claims": "fixtures/claims/registry.json",
  "manuscript": "fixtures/claims/manuscript.md",
  "corpus": {
    "access_class": "SYNTHETIC",
    "permissions": {
      "evaluation_allowed": true,
      "training_allowed": false,
      "redistribution_allowed": false,
      "derivatives_allowed": false,
      "public_display_allowed": false,
      "commercial_use_allowed": false
    }
  }
}
