{
  "schema": "science-gate-manifest/v1",
  "run_label": "<REPLACE: corpus-<entry-id>>",
  "inputs": [
    {
      "id": "<REPLACE: input id>",
      "path": "<REPLACE: fixtures/data/<file>.csv>",
      "format": "csv",
      "required": true,
      "sha256": "<REPLACE: sha256 of the exact file bytes>",
      "row_key": [
        "<REPLACE: key column>"
      ],
      "expected_rows": "<REPLACE: integer row count, known independently of the file>",
      "denominator_source": "INDEPENDENT"
    }
  ],
  "checks": [
    {
      "id": "rows",
      "kind": "row_count",
      "version": "1",
      "required": true,
      "inputs": [
        "<REPLACE: input id>"
      ]
    },
    {
      "id": "columns",
      "kind": "required_columns",
      "version": "1",
      "required": true,
      "inputs": [
        "<REPLACE: input id>"
      ],
      "params": {
        "columns": [
          "<REPLACE: column>",
          "<REPLACE: column>"
        ]
      }
    },
    {
      "id": "reviewers",
      "kind": "reviewer_protocol",
      "version": "1",
      "required": true
    }
  ],
  "reviews": {
    "required_reviewers": [
      "<REPLACE: reviewer id>",
      "<REPLACE: reviewer id>"
    ],
    "verdicts": "fixtures/reviews/verdicts.json"
  },
  "corpus": {
    "access_class": "SYNTHETIC",
    "permissions": {
      "evaluation_allowed": true,
      "training_allowed": false,
      "redistribution_allowed": false,
      "derivatives_allowed": false,
      "public_display_allowed": false,
      "commercial_use_allowed": false
    }
  }
}
